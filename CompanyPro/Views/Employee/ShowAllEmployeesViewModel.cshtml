@{
    Layout = "CustomeLayout";
}

<a class="btn btn-primary" asp-controller="Employee" asp-action="AddNew">Add New Employee</a>
<table class="table table-bordered table-hover">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Salary</th>
        <th>DepartmentId</th>
        <th>Address</th>
    </tr>

    @foreach (var employee in @Model)
    {
        <tr>
            <td style="color:@employee?.Color">@employee?.Eid</td>
            <td style="color:@employee?.Color">@employee?.EmpName</td>
            <td style="color:@employee?.Color">@employee?.Salary</td>
            <td style="color:@employee?.Color">@employee?.DeptName</td>
            <td style="color:@employee?.Color">@employee?.Address</td>
        </tr>
    }
</table>

